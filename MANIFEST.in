include LICENSE COPYING COPYING.LESSER THIRD_PARTY_NOTICES.md
include README.md
include pyproject.toml

recursive-include delfin *.py
recursive-include delfin/notebooks *.ipynb
recursive-include delfin/logo *.png *.PNG *.gif
recursive-include tests *.py

include delfin/qm_tools/*.txt
include delfin/qm_tools/*.sh
include delfin/submit_templates/*.sh
include delfin/installers/*.sh

# What the installers download or build lands beside them in a checkout.
# It is third-party software under its own licence, fetched from upstream
# at install time, and is never shipped. The prunes come after every
# include because MANIFEST.in applies its lines in order.
prune delfin/csp_tools/.build
prune delfin/qm_tools/bin
prune delfin/qm_tools/share
prune delfin/qm_tools/downloads
prune delfin/qm_tools/build
prune delfin/qm_tools/third_party
prune delfin/qm_tools/logs
prune delfin/qm_tools/.mamba_env
prune delfin/csp_tools/bin
prune delfin/mlp_tools/bin
prune delfin/analysis_tools/bin
prune delfin/ai_tools/bin
global-exclude __pycache__ *.py[cod]

# The terminal window's sources, which setup.py copies into the wheel
# (delfin/agent/service/tui_sources); setup.py's TUI_FILES is the list.
include setup.py
include tui/package.json tui/bun.lock tui/bunfig.toml tui/tsconfig.json
recursive-include tui/src *.ts *.tsx
include tui/patches/*.patch
include tui/scripts/install-bun.sh tui/scripts/build-opentui-native.sh tui/scripts/build-binary.ts
