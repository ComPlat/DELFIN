 def _is_honoured_dry_run(name: str, arguments) -> bool:
-    """True when ``check_only`` on this call is a dry run its executor runs.
-
-    Only the native ``apply_patch`` has one (``git apply --check``). On any
-    other tool, and on every MCP tool, the flag is an argument the executor
-    may ignore -- an MCP server drops a key its schema does not name and
-    performs the call -- so it decides nothing.
+    """True when this call's OWN flag makes it a dry run its executor runs.
+
+    ``apply_patch`` has ``check_only`` (``git apply --check``); ``lab_run``
+    has ``dry_run``, which ``delfin.lab.tools._lab_run`` reads and honours
+    (it answers the judged plan with ``ran: false`` and writes nothing).
+    Both are decided by the ARGUMENT, never by the tool name alone -- which
+    is the point of this function: on any other tool, and on every MCP
+    tool, a dry-run-looking flag is an argument the executor may ignore (an
+    MCP server drops a key its schema does not name and performs the call),
+    so it decides nothing.
+
+    WHY lab_run IS NOT IN ``_PLAN_READONLY_TOOLS``. It was added to that set
+    in wave 44 and measured: plan mode -- the read-only profile -- called it
+    with ``dry_run: false``, the NAME-only gate admitted the call, the
+    workflow ran and the simulator's stirrer came back ``power: 'on'``. A
+    set of names cannot carry an argument-conditional permission, so the
+    tool stays out of the set and this decides the call instead.
     """
-    return name == "apply_patch" and bool((arguments or {}).get("check_only"))
+    if name == "apply_patch":
+        return bool((arguments or {}).get("check_only"))
+    if name == "lab_run":
+        # Absent means the tool's own default, which is the dry run.
+        return bool((arguments or {}).get("dry_run", True))
+    return False
 
 
