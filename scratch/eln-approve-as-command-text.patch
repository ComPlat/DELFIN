diff --git a/tests/test_eln_approve_is_refused_as_command_text.py b/tests/test_eln_approve_is_refused_as_command_text.py
new file mode 100644
--- /dev/null
+++ b/tests/test_eln_approve_is_refused_as_command_text.py
+"""The person's `eln approve` is refused as command text, like `approvals approve`.
+
+Input: the spellings of the same act, built as strings and handed to
+``approval_guard.answer_command`` -- and, for the shell route, to the real
+permission gate as a ``bash`` command.
+Output: each one is refused as an approval-answer before the process marker
+is ever consulted, so a shell that drops ``DELFIN_AGENT_SESSION`` still
+cannot mint a grant.
+Controls: the read verbs (``pending``, ``show``, ``collections``) stay free,
+``delfin-agent approvals approve`` keeps answering as it did, and merely
+importing or reading the module is not refused.
+
+Why it exists. The docstring of ``delfin/lab/eln_cli.py`` claimed this layer
+and the code did not have it: measured on this tree before the fix,
+``answer_command("delfin-agent eln approve X")`` was ``None``, so the only
+gate was the environment variable. A gate the act reaches by dropping one
+variable is not a gate.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from delfin.agent import approval_guard
+
+SUB = "delfin-agent"
+
+
+def _cmd(*words: str) -> str:
+    """A command line, joined here -- never typed into a shell."""
+    return " ".join((SUB,) + words)
+
+
+ANSWERS = {
+    "eln approve": _cmd("eln", "approve", "eln-abc123"),
+    "eln approve with a flag": _cmd("eln", "approve",
+                                    "--request-id=eln-abc123"),
+    "eln approve behind env -u": (
+        "env -u DELFIN_AGENT_SESSION " + _cmd("eln", "approve", "eln-abc123")),
+    "eln approve in a nested shell": (
+        "bash -c '" + _cmd("eln", "approve", "eln-abc123") + "'"),
+    "eln deny": _cmd("eln", "deny", "eln-abc123"),
+    "the python route": (
+        "from delfin.lab import eln_write; eln_write.grant('eln-abc123')"),
+}
+
+FREE = {
+    "eln pending reads": _cmd("eln", "pending"),
+    "eln show reads": _cmd("eln", "show", "eln-abc123"),
+    "eln collections reads": _cmd("eln", "collections"),
+    "reading the module is not answering": (
+        "grep -n 'def grant' delfin/lab/eln_write.py"),
+}
+
+
+@pytest.mark.parametrize("label,cmd", sorted(ANSWERS.items()))
+def test_answering_an_eln_write_is_refused_as_command_text(label, cmd):
+    assert approval_guard.answer_command(cmd) is not None, (
+        f"{label}: {cmd!r} mints or drops an ELN grant and the command gate "
+        "does not see it -- the process marker would be the only layer")
+
+
+@pytest.mark.parametrize("label,cmd", sorted(FREE.items()))
+def test_the_reads_and_a_plain_import_stay_free(label, cmd):
+    assert approval_guard.answer_command(cmd) is None, (
+        f"{label}: {cmd!r} was refused as an answer, and it only reads")
+
+
+def test_the_approvals_room_still_answers():
+    """The control: the spelling the regex already knew is unchanged."""
+    assert approval_guard.answer_command(
+        _cmd("approvals", "approve", "7")) is not None
