diff --git a/delfin/agent/api_client.py b/delfin/agent/api_client.py
index 2867e7d40..5e7192778 100644
--- a/delfin/agent/api_client.py
+++ b/delfin/agent/api_client.py
@@ -20422,7 +20422,17 @@ class _DocToolExecutor:
                 continue
             # Match against the bare filename too, so a pattern like "*.py"
             # (no directory component) matches nested files as users expect.
-            if fnmatch.fnmatch(rel, pattern) or fnmatch.fnmatch(fp.name, pattern):
+            #
+            # ``fnmatch`` is not a glob: ``**`` means nothing to it, so
+            # ``**/*.md`` did not match ``one.md`` at the top level of the
+            # directory the caller named -- only files below a subdirectory.
+            # A real run asked for exactly that pattern in a directory of 67
+            # ``.md`` files and got "No files matching pattern.", then had to
+            # fall back to ``ls``. A leading ``**/`` means "here and below",
+            # so strip it and keep the suffix rule; without the prefix the
+            # matcher below is unchanged.
+            _pfx = pattern[3:] if pattern.startswith("**/") else pattern
+            if (fnmatch.fnmatch(rel, _pfx) or fnmatch.fnmatch(fp.name, _pfx)):
                 matches.append(rel)
                 if len(matches) > 50:
                     break
