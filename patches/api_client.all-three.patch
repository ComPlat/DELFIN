+        # The translation must reach the CALLER's dict, not only the check
+        # copy above. `grep_file` and `list_files` read
+        # ``arguments["path"]`` / ``arguments["pattern"]`` directly
+        # (api_client.py:20283, :20293, :20402); only the tools that go
+        # through ``_get_path_arg`` ever saw `file_path`. Measured
+        # 2026-11-26: `grep_file(pattern="def", file_path="calc")`
+        # therefore searched the WHOLE workspace and answered with files
+        # from outside `calc`, while the same call with `path="calc"`
+        # answered correctly -- so the alias table's promise ("Keys a tool
+        # accepts INSTEAD of the one its schema names", :2353) held for the
+        # check and not for the tool that does the work.
+        #
+        # The canonical key is ADDED; the alias the caller used is left in
+        # place, because a body that reads the alias keeps working, and
+        # ``_get_path_arg`` reads `path` first, so the canonical value wins
+        # wherever both exist.
+        for canonical, alias in alias_of.items():
+            if canonical not in arguments and alias in arguments:
+                arguments[canonical] = arguments[alias]
         required = [r for r in schema.get("required") or []
                     if (bare, r) not in _LABEL_ONLY]
+        # A field the tool honours though the schema does not advertise it is
+        # a KNOWN field, not a stray. Adding it to `properties` is what makes
+        # the stray rule leave it alone, and what keeps the refusal aimed at
+        # the defensible question -- "did you misspell a field that exists?" --
+        # instead of "is this field in the catalogue?".
+        honoured = _UNDOCUMENTED_ARGS.get(bare)
+        if honoured:
+            props = {**props}
+            for _f in honoured:
