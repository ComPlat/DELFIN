+# call as an "unknown field" answers a working request with a typo warning.
+# Measured: it broke test_a_long_output_is_capped_from_the_front, which passes
+# on origin/main, and told the caller to use max_source_chars -- a different
+# cap that would have left the output uncapped.
+_UNDOCUMENTED_ARGS: dict[str, frozenset[str]] = {
+    "notebook_read": frozenset({"max_output_chars"}),
+}
+
 # Tools that carry their OWN plan-mode refusal in their body, past the
